# AI Provider selection (default: "claude", options: "claude", "huggingface", "ollama")
AI_PROVIDER=claude

# For Claude provider (paid, most capable)
# Get key at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your-api-key-here

# For HuggingFace provider (free tier available)
# Get key at: https://huggingface.co/settings/tokens
# Free tier supports text generation but with rate limits
HUGGINGFACE_API_KEY=hf_your-token-here

# For Ollama provider (free, self-hosted)
# Install Ollama: https://ollama.ai
# Run: ollama run mistral (or your preferred model)
# Set to your Ollama server URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
